# Database
DATABASE_URL="postgresql://cora:cora_secret@localhost:5432/cora_erp?schema=public"

# JWT
JWT_SECRET="change-me-in-production-min-32-chars-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-in-production-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

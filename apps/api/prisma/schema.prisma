model DdrEntry {
  id           String   @id @default(uuid()) @db.Uuid
  reportId     String   @db.Uuid
  accountCode  String   @db.VarChar(6)
  currencyCode String?  @db.VarChar(3)
  countryCode  String?  @db.VarChar(2)
  positionType Int?
  value        Decimal  @db.Decimal(18, 2)
  isCalculated Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  report DdrReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, accountCode, currencyCode, countryCode, positionType])
  @@index([reportId])
  @@index([accountCode])
  @@map("ddr_entries")
}

model DdrParameter {
  id            String   @id @default(uuid()) @db.Uuid
  reportId      String   @db.Uuid
  parameterCode String   @db.VarChar(20)
  value         Decimal  @db.Decimal(18, 8)
  source        String?  @db.VarChar(100)
  createdAt     DateTime @default(now())

  report DdrReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, parameterCode])
  @@map("ddr_parameters")
}
